# local (mặc định) | supabase
VITE_BACKEND=local
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Đăng nhập bằng Google — chế độ local: dán OAuth Client ID (loại "Web application") từ Google Cloud Console.
# Chế độ supabase: KHÔNG cần biến này, bật Google trong Supabase › Authentication › Providers.
VITE_GOOGLE_CLIENT_ID=
